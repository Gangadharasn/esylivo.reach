# MongoDB Atlas connection string (Atlas is a replica set, which the app needs for transactions).
# Use a database name of its own, e.g. /esylivoreach, not one shared with another app.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/esylivoreach?retryWrites=true&w=majority"

# Signs login sessions and encrypts saved API keys/passwords. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Public URL of the app.
APP_URL="http://localhost:3000"

# Protects /api/cron/run, which runs due automatic searches for all users. Call it every few hours.
CRON_SECRET=""

# Required for job search. The app's own Apify token (https://console.apify.com/settings/integrations),
# used server-side only; users never see it. Searches cost about $1.50 per 1,000 posts.
APIFY_TOKEN=""

# Optional — AI-written resume summaries and emails from ANY OpenAI-compatible model,
# including free local ones. Example (Ollama): AI_BASE_URL="http://localhost:11434/v1" AI_MODEL="llama3.2"
# Leave empty to use the built-in templates (no AI, no cost).
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# ---- Credits and billing ----
# Users are charged CREDIT_MARKUP × the Apify cost of each search (2 = 50% of credit spend is margin).
CREDIT_MARKUP="2"
# Free credit for every new account, and the Pro plan price (its monthly credit equals the price).
FREE_CREDIT_USD="2"
PRO_PRICE_USD="10"

# Lemon Squeezy (https://app.lemonsqueezy.com) for the Pro subscription.
# Product: one subscription with a monthly variant at PRO_PRICE_USD; paste its variant ID.
# Webhook: URL https://<your-domain>/api/billing/webhook, events subscription_* (including
# subscription_payment_success); paste the signing secret you chose.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_VARIANT_PRO=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# Testing only: "true" makes Upgrade add Pro credit without payment. Must be false in production.
SKIP_PAYMENT_GATEWAY="false"
